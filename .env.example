# Copy to .env and adjust if you need something other than the defaults.
# docker compose reads .env automatically.

# OpenStreetMap extract OSRM routes on. Must match a file in data/ — fetch it
# with ./scripts/fetch-osm.sh. Default is the Midi-Pyrénées region (~390 MB),
# which covers the Rodez area the sample data uses.
OSM_FILE=midi-pyrenees-latest.osm.pbf

# Where ./scripts/fetch-osm.sh downloads from. Browse
# https://download.openstreetmap.fr/extracts/ (France by department) or
# https://download.geofabrik.de/ (countries and large regions) for others, and
# keep OSM_FILE in sync with the filename in the URL.
OSM_REGION_URL=https://download.geofabrik.de/europe/france/midi-pyrenees-latest.osm.pbf

# Origins the backend accepts cross-origin API calls from (comma-separated,
# '*' wildcards allowed). Set this to your own domain when deploying.
APP_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
