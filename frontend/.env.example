# Copy to .env for local development.
#
# In production these are left as literal placeholders at build time and
# rewritten in the container by env.sh, so the same image works on any host.

# Backend API root. With `bun dev`, vite proxies /api to 127.0.0.1:8012, so the
# relative form works too.
VITE_API_BASE_URL=http://localhost:8012/api

# OSRM root, used directly by the map for route geometries.
VITE_OSRM_BASE_URL=http://localhost:5001
